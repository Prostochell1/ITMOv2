{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/itmo-agent",
  "small_model": "ollama/itmo-agent",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama local",
      "options": {
          "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "itmo-agent": {
          "name": "ITMO local 64k",
          "limit": {
            "context": 32768,
            "output": 1024
          }
        }
      }
    }
  },
  "agent": {
    "local-guide": {
      "description": "Read-only local repository assistant",
      "mode": "primary",
      "prompt": "{file:../../../../repo-system-A.txt}",
      "steps": 5,
      "permission": {
        "*": "deny",
        "read": "allow"
      }
    },
    "local-guide-b": {
      "description": "Read-only assistant (B prompt)",
      "mode": "primary",
      "prompt": "{file:../../../../repo-system-B.txt}",
      "steps": 5,
      "permission": {
        "*": "deny",
        "read": "allow"
      }
    }
  }
}
